<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content">
  <title>{{ page.title | default(site.title) }}</title>
  <link rel="alternate" hreflang="{{ page.lang }}" href="{{ page.url }}">
  {% for link in page.url | locale_links %}
    <link rel="alternate" hreflang="{{ link.lang }}" href="{{ config.BASE_URL }}{{ link.url }}">
  {% endfor %}
  <meta name="color-scheme" content="light dark" />
  <link rel="stylesheet" href="{{ '/assets/scss/main.css' | relative_url }}">
  <link rel="icon" href="{{ '/favicon.ico' | relative_url }}" type="image/x-icon">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <script>
    window.API_URL = "{{ config.API_URL }}";
  </script>
  <script src="{{ '/assets/js/main.js' | relative_url }}" defer></script>
  <script defer data-domain="judetopia.com" src="https://analytics.emeraldcity.ai/js/script.hash.outbound-links.pageview-props.tagged-events.js"></script>
  <script>window.plausible = window.plausible || function() { (window.plausible.q = window.plausible.q || []).push(arguments) }</script>
</head>
